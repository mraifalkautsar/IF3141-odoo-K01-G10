<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_safago_dashboard" model="ir.module.category">
        <field name="name">SAFAGO Dashboard</field>
        <field name="description">Akses dashboard monitoring produksi SAFAGO.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_safago_dashboard_viewer" model="res.groups">
        <field name="name">SAFAGO Dashboard Viewer</field>
        <field name="category_id" ref="safago_spk.module_category_safago_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="access_safago_spk_dashboard_viewer" model="ir.model.access">
        <field name="name">safago.spk.dashboard.viewer</field>
        <field name="model_id" ref="model_safago_spk_dashboard"/>
        <field name="group_id" ref="safago_spk.group_safago_dashboard_viewer"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
