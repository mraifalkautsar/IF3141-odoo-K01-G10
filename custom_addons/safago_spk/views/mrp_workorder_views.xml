<odoo>
    <record id="mrp_production_workorder_tree_editable_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.workorder.tree.editable.view.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="production_stage" widget="badge" 
                       decoration-info="production_stage == 'cutting'" 
                       decoration-warning="production_stage == 'sewing'" 
                       decoration-success="production_stage in ('finishing', 'qc_valid')"
                       decoration-danger="production_stage == 'qc_reject'"/>
            </xpath>
        </field>
    </record>
</odoo>
