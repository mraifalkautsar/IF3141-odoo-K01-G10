<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_safago_spk" model="ir.actions.act_window">
        <field name="name">Surat Perintah Kerja</field>
        <field name="res_model">safago.spk</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_safago_spk_root" name="SPK SAFAGO" sequence="10"/>
    <menuitem id="menu_safago_spk_list" name="Daftar SPK" parent="menu_safago_spk_root" action="action_safago_spk" sequence="10"/>

    <record id="view_safago_spk_tree" model="ir.ui.view">
        <field name="name">safago.spk.tree</field>
        <field name="model">safago.spk</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="roll_kain_id"/>
                <field name="tanggal_mulai"/>
                <field name="deadline_selesai"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'aktif')" decoration-warning="state in ('cacat_review', 'qc_reject')" decoration-success="state == 'selesai'"/>
                <field name="is_overdue"/>
                <field name="jumlah_pemakaian_yard"/>
            </tree>
        </field>
    </record>

    <record id="view_safago_spk_form" model="ir.ui.view">
        <field name="name">safago.spk.form</field>
        <field name="model">safago.spk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mulai_produksi" string="Mulai Produksi" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_selesai_produksi" string="Selesaikan Produksi" type="object" class="oe_highlight" invisible="state not in ('proses', 'cutting')"/>
                    <button name="action_batal_produksi" string="Batalkan" type="object" class="oe_highlight" invisible="state not in ('proses', 'cacat_review', 'cutting', 'menunggu_qc', 'validasi_qc', 'qc_reject')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <div style="display:flex; gap:32px; align-items:flex-start;">
                        <div style="flex:1;">
                            <group string="Informasi SPK">
                                <field name="roll_kain_id"/>
                                <field name="tanggal_mulai"/>
                                <field name="deadline_selesai"/>
                                <field name="state"/>
                                <field name="jumlah_pemakaian_yard" readonly="state != 'draft'"/>
                                <field name="is_overdue" readonly="1"/>
                                <field name="overdue_hours" readonly="1"/>
                                <field name="last_alert_at" readonly="1"/>
                                <field name="alert_count" readonly="1"/>
                            </group>
                        </div>
                        <div style="flex:0 0 auto; text-align:center;" invisible="not qr_spk_image">
                            <field name="qr_spk_image"
                                widget="image"
                                options="{'size': [200, 200]}"
                                readonly="1"
                                nolabel="1"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
