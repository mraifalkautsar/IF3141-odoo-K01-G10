<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_safago_spk_dashboard_kanban" model="ir.ui.view">
        <field name="name">safago.spk.dashboard.kanban</field>
        <field name="model">safago.spk.dashboard</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false" class="o_kanban_dashboard">
                <field name="state"/>
                <field name="spk_count"/>
                <field name="spk_count_delta"/>
                <field name="spk_count_trend_label"/>
                <field name="total_pemakaian_yard"/>
                <field name="total_pemakaian_yard_delta"/>
                <field name="total_yard_trend_label"/>
                <field name="avg_pemakaian_yard"/>
                <field name="overdue_count"/>
                <field name="overdue_count_delta"/>
                <field name="overdue_trend_label"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click" style="min-width: 280px; border-radius: 8px; padding: 22px;">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="state"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div style="margin-top: 12px;">
                                    <div style="color: #64748b; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;">SPK</div>
                                    <div style="font-size: 32px; font-weight: 700; line-height: 1; margin-top: 4px;"><field name="spk_count"/></div>
                                    <div t-attf-style="margin-top: 12px; font-size: 13px; font-weight: 700; color: #{record.spk_count_delta.raw_value &gt;= 0 ? '#16a34a' : '#dc2626'};">
                                        <field name="spk_count_trend_label"/>
                                    </div>
                                </div>
                                <div style="margin-top: 22px;">
                                    <div style="color: #64748b; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;">Total Yard</div>
                                    <div style="font-size: 22px; font-weight: 700; margin-top: 4px;"><field name="total_pemakaian_yard"/></div>
                                    <div t-attf-style="margin-top: 8px; font-size: 13px; font-weight: 700; color: #{record.total_pemakaian_yard_delta.raw_value &gt;= 0 ? '#16a34a' : '#dc2626'};">
                                        <field name="total_yard_trend_label"/>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 28px; margin-top: 22px;">
                                    <div>
                                        <div style="color: #64748b; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;">Rata-rata Yard</div>
                                        <div style="font-size: 18px; font-weight: 700; margin-top: 4px;"><field name="avg_pemakaian_yard"/></div>
                                    </div>
                                    <div>
                                        <div style="color: #64748b; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;">Overdue</div>
                                        <div style="font-size: 18px; font-weight: 700; margin-top: 4px;"><field name="overdue_count"/></div>
                                        <div t-attf-style="margin-top: 8px; font-size: 12px; font-weight: 700; color: #{record.overdue_count_delta.raw_value &lt;= 0 ? '#16a34a' : '#dc2626'};">
                                            <field name="overdue_trend_label"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_safago_spk_dashboard_tree" model="ir.ui.view">
        <field name="name">safago.spk.dashboard.tree</field>
        <field name="model">safago.spk.dashboard</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="state"/>
                <field name="spk_count" sum="Total SPK"/>
                <field name="previous_spk_count" sum="Total SPK Bulan Lalu"/>
                <field name="spk_count_delta" decoration-success="spk_count_delta &gt;= 0" decoration-danger="spk_count_delta &lt; 0"/>
                <field name="spk_count_delta_percent" decoration-success="spk_count_delta_percent &gt;= 0" decoration-danger="spk_count_delta_percent &lt; 0"/>
                <field name="total_pemakaian_yard" sum="Total Yard"/>
                <field name="previous_total_pemakaian_yard" sum="Total Yard Bulan Lalu"/>
                <field name="total_pemakaian_yard_delta" decoration-success="total_pemakaian_yard_delta &gt;= 0" decoration-danger="total_pemakaian_yard_delta &lt; 0"/>
                <field name="total_pemakaian_yard_delta_percent" decoration-success="total_pemakaian_yard_delta_percent &gt;= 0" decoration-danger="total_pemakaian_yard_delta_percent &lt; 0"/>
                <field name="avg_pemakaian_yard" avg="Rata-Rata Yard"/>
                <field name="previous_avg_pemakaian_yard" avg="Rata-Rata Yard Bulan Lalu"/>
                <field name="avg_pemakaian_yard_delta" decoration-success="avg_pemakaian_yard_delta &gt;= 0" decoration-danger="avg_pemakaian_yard_delta &lt; 0"/>
                <field name="avg_pemakaian_yard_delta_percent" decoration-success="avg_pemakaian_yard_delta_percent &gt;= 0" decoration-danger="avg_pemakaian_yard_delta_percent &lt; 0"/>
                <field name="overdue_count" sum="Total Overdue"/>
                <field name="previous_overdue_count" sum="Total Overdue Bulan Lalu"/>
                <field name="overdue_count_delta" decoration-success="overdue_count_delta &lt;= 0" decoration-danger="overdue_count_delta &gt; 0"/>
                <field name="overdue_count_delta_percent" decoration-success="overdue_count_delta_percent &lt;= 0" decoration-danger="overdue_count_delta_percent &gt; 0"/>
            </tree>
        </field>
    </record>

    <record id="view_safago_spk_dashboard_graph" model="ir.ui.view">
        <field name="name">safago.spk.dashboard.graph</field>
        <field name="model">safago.spk.dashboard</field>
        <field name="arch" type="xml">
            <graph string="Dashboard Produksi SAFAGO" type="bar">
                <field name="state" type="row"/>
                <field name="spk_count" type="measure"/>
                <field name="total_pemakaian_yard" type="measure"/>
                <field name="overdue_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_safago_spk_dashboard_search" model="ir.ui.view">
        <field name="name">safago.spk.dashboard.search</field>
        <field name="model">safago.spk.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="state"/>
                <filter name="has_current_spk" string="Ada SPK Bulan Ini" domain="[('spk_count', '&gt;', 0)]"/>
                <filter name="has_overdue" string="Ada Overdue" domain="[('overdue_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_safago_spk_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Produksi</field>
        <field name="res_model">safago.spk.dashboard</field>
        <field name="view_mode">kanban,tree,graph</field>
        <field name="search_view_id" ref="view_safago_spk_dashboard_search"/>
        <field name="context">{'search_default_group_by_state': 0}</field>
    </record>

    <menuitem
        id="menu_safago_spk_dashboard"
        name="Dashboard Produksi"
        parent="menu_safago_spk_root"
        action="action_safago_spk_dashboard"
        groups="safago_spk.group_safago_dashboard_viewer"
        sequence="20"/>
</odoo>
